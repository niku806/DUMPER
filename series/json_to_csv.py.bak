import os
import json
import csv
import re
from concurrent.futures import ThreadPoolExecutor, as_completed
from urllib.parse import urlparse

# ============================================================
# CONFIG
# ============================================================

BASE_DIR = os.path.expanduser(
    "~/storage/downloads/scrap/data/series"
)

OUTPUT_FILE = os.path.join(BASE_DIR, "anime_dataset.csv")

MAX_WORKERS = min(16, (os.cpu_count() or 4) * 2)

# ============================================================
# HELPERS
# ============================================================

def clean_text(value):
    if value is None:
        return ""

    if isinstance(value, str):
        return value.replace("\r", " ").replace("\n", " ").strip()

    return str(value)


def json_string(value):
    if value is None:
        return ""

    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":")
    )


def list_to_text(value):
    if not value:
        return ""

    if isinstance(value, list):
        return " | ".join(clean_text(x) for x in value)

    return clean_text(value)


def get_slug(url):
    if not url:
        return ""

    try:
        path = urlparse(url).path.strip("/")
        if not path:
            return ""

        slug = path.split("/")[-1]

        # Remove trailing slash / unnecessary parts
        return slug.strip()

    except Exception:
        return ""


def get_video_id(url):
    """
    Example:
    ?trdekho=1&trid=49367&trtype=2

    Returns:
    49367
    """

    if not url:
        return ""

    match = re.search(r"(?:[?&])trid=(\d+)", url)

    if match:
        return match.group(1)

    return ""


def safe_filename(path):
    return os.path.basename(path)


# ============================================================
# LOAD ONE JSON
# ============================================================

def load_json_file(filepath):

    try:
        with open(
            filepath,
            "r",
            encoding="utf-8"
        ) as f:
            data = json.load(f)

        return {
            "file": filepath,
            "data": data,
            "error": ""
        }

    except Exception as e:

        return {
            "file": filepath,
            "data": None,
            "error": str(e)
        }


# ============================================================
# FIND ALL JSON FILES
# ============================================================

def find_json_files():

    files = []

    for root, dirs, filenames in os.walk(BASE_DIR):

        for filename in filenames:

            if filename.lower().endswith(".json"):

                full_path = os.path.join(root, filename)

                # Don't accidentally read our output
                if full_path != OUTPUT_FILE:
                    files.append(full_path)

    return sorted(files)


# ============================================================
# EXTRACT EPISODES
# ============================================================

def get_episode_records(series):

    records = []

    episodes_data = series.get("episodes_data")

    if isinstance(episodes_data, list) and episodes_data:

        for episode in episodes_data:

            if isinstance(episode, dict):
                records.append(episode)

    # Fallback if episodes_data doesn't exist
    elif isinstance(series.get("episodes"), list):

        for episode in series["episodes"]:

            if isinstance(episode, dict):

                records.append(episode)

    # If there is no episode list at all,
    # still preserve the series as one row
    if not records:
        records.append({})

    return records


# ============================================================
# FIND MAXIMUM STREAM / DOWNLOAD COUNTS
# ============================================================

def analyze_file(result):

    data = result["data"]

    if not isinstance(data, dict):
        return {
            "stream_max": 0,
            "download_max": 0
        }

    max_stream = 0
    max_download = 0

    episodes = get_episode_records(data)

    for episode in episodes:

        streams = episode.get("streaming_servers", [])

        downloads = episode.get("download_links", [])

        if isinstance(streams, list):
            max_stream = max(
                max_stream,
                len(streams)
            )

        if isinstance(downloads, list):
            max_download = max(
                max_download,
                len(downloads)
            )

    return {
        "stream_max": max_stream,
        "download_max": max_download
    }


# ============================================================
# BASE HEADERS
# ============================================================

BASE_HEADERS = [
    "ID",
    "ANIME",
    "SLUG",
    "SEASON",
    "EPISODE",
    "TITLE",
    "VIDEO_ID",
    "VIDEO_URL",
    "VIDEO_URL2",
    "DOWNLOAD_URL",
    "BANNER_URL",
    "POSTER_URL",
    "THUMBNAIL_URL",
    "CATEGORY 1",
    "CATEGORY 2",
    "CATEGORY 3",
    "DATE",
    "KEYWORDS",
]


# ============================================================
# CREATE DYNAMIC HEADERS
# ============================================================

def make_headers(max_streams, max_downloads):

    headers = BASE_HEADERS.copy()

    # --------------------------------------------------------
    # STREAMING
    # --------------------------------------------------------

    for i in range(1, max_streams + 1):

        suffix = "" if i == 1 else str(i)

        headers.append(f"VIDEO_URL{suffix}")
        headers.append(f"VIDEO_NAME{suffix}")
        headers.append(f"VIDEO_RAW{suffix}")

    # --------------------------------------------------------
    # DOWNLOADS
    # --------------------------------------------------------

    for i in range(1, max_downloads + 1):

        suffix = "" if i == 1 else str(i)

        headers.append(f"DOWNLOAD_URL{suffix}")
        headers.append(f"DOWNLOAD_LABEL{suffix}")
        headers.append(f"DOWNLOAD_DECODED{suffix}")

    # --------------------------------------------------------
    # EXTRA EPISODE DATA
    # --------------------------------------------------------

    headers.extend([
        "DESCRIPTION",
        "YEAR",
        "DURATION",
        "RATING",
        "GENRES",
        "CAST",
        "NEXT_EPISODE",
        "PREV_EPISODE",
        "IFRAMES",
        "EPISODE_IMAGE",
    ])

    # --------------------------------------------------------
    # SERIES DATA
    # --------------------------------------------------------

    headers.extend([
        "SERIES_URL",
        "SERIES_DESCRIPTION",
        "SERIES_YEAR",
        "SERIES_GENRES",
        "SERIES_CAST",
        "SERIES_IMAGE",
        "SOURCE_JSON_FILE",
    ])

    # --------------------------------------------------------
    # COMPLETE RAW DATA
    # --------------------------------------------------------

    headers.append("RAW_JSON")

    return headers


# ============================================================
# KEYWORDS
# ============================================================

def generate_keywords(series, episode):

    keywords = []

    title = series.get("title")
    episode_title = episode.get("title")

    if title:
        keywords.append(clean_text(title))

    if episode_title:
        keywords.append(clean_text(episode_title))

    genres = series.get("genres", [])

    if isinstance(genres, list):
        keywords.extend(
            clean_text(x)
            for x in genres
        )

    cast = episode.get("cast")

    if not cast:
        cast = series.get("cast", [])

    if isinstance(cast, list):
        keywords.extend(
            clean_text(x)
            for x in cast
        )

    year = episode.get("year") or series.get("year")

    if year:
        keywords.append(str(year))

    # Remove duplicates while preserving order
    result = []

    seen = set()

    for item in keywords:

        item = clean_text(item)

        if not item:
            continue

        key = item.lower()

        if key not in seen:

            seen.add(key)
            result.append(item)

    return " | ".join(result)


# ============================================================
# CREATE ONE CSV ROW
# ============================================================

def make_row(
    series,
    episode,
    source_file,
    row_id,
    max_streams,
    max_downloads
):

    row = {}

    # --------------------------------------------------------
    # SERIES
    # --------------------------------------------------------

    anime = clean_text(
        series.get("title")
    )

    series_url = clean_text(
        series.get("url")
    )

    slug = get_slug(series_url)

    genres = series.get("genres", [])

    cast = series.get("cast", [])

    # --------------------------------------------------------
    # EPISODE
    # --------------------------------------------------------

    episode_url = clean_text(
        episode.get("url")
    )

    season = episode.get("season", "")

    episode_number = episode.get(
        "episode",
        ""
    )

    episode_title = clean_text(
        episode.get("title")
    )

    # --------------------------------------------------------
    # STREAMS
    # --------------------------------------------------------

    streams = episode.get(
        "streaming_servers",
        []
    )

    if not isinstance(streams, list):
        streams = []

    # --------------------------------------------------------
    # DOWNLOADS
    # --------------------------------------------------------

    downloads = episode.get(
        "download_links",
        []
    )

    if not isinstance(downloads, list):
        downloads = []

    # --------------------------------------------------------
    # VIDEO ID
    # --------------------------------------------------------

    video_id = ""

    for stream in streams:

        if not isinstance(stream, dict):
            continue

        stream_url = clean_text(
            stream.get("url")
        )

        video_id = get_video_id(
            stream_url
        )

        if video_id:
            break

    if not video_id:

        video_id = get_video_id(
            episode_url
        )

    # --------------------------------------------------------
    # BASIC DATA
    # --------------------------------------------------------

    row["ID"] = row_id

    row["ANIME"] = anime

    row["SLUG"] = slug

    row["SEASON"] = season

    row["EPISODE"] = episode_number

    row["TITLE"] = episode_title

    row["VIDEO_ID"] = video_id

    # --------------------------------------------------------
    # FIRST VIDEO URL
    # --------------------------------------------------------

    for i in range(max_streams):

        suffix = "" if i == 0 else str(i + 1)

        url_key = f"VIDEO_URL{suffix}"
        name_key = f"VIDEO_NAME{suffix}"
        raw_key = f"VIDEO_RAW{suffix}"

        if i < len(streams):

            stream = streams[i]

            if isinstance(stream, dict):

                row[url_key] = clean_text(
                    stream.get("url")
                )

                row[name_key] = clean_text(
                    stream.get("name")
                )

                row[raw_key] = clean_text(
                    stream.get("raw")
                )

            else:

                row[url_key] = clean_text(
                    stream
                )

                row[name_key] = ""
                row[raw_key] = ""

        else:

            row[url_key] = ""
            row[name_key] = ""
            row[raw_key] = ""

    # --------------------------------------------------------
    # DOWNLOAD URLS
    # --------------------------------------------------------

    for i in range(max_downloads):

        suffix = "" if i == 0 else str(i + 1)

        url_key = f"DOWNLOAD_URL{suffix}"
        label_key = f"DOWNLOAD_LABEL{suffix}"
        decoded_key = f"DOWNLOAD_DECODED{suffix}"

        if i < len(downloads):

            download = downloads[i]

            if isinstance(download, dict):

                row[url_key] = clean_text(
                    download.get("url")
                )

                row[label_key] = clean_text(
                    download.get("label")
                )

                row[decoded_key] = clean_text(
                    download.get("decoded")
                )

            else:

                row[url_key] = clean_text(
                    download
                )

                row[label_key] = ""
                row[decoded_key] = ""

        else:

            row[url_key] = ""
            row[label_key] = ""
            row[decoded_key] = ""

    # --------------------------------------------------------
    # IMAGES
    # --------------------------------------------------------

    row["BANNER_URL"] = clean_text(
        series.get("image")
    )

    row["POSTER_URL"] = clean_text(
        episode.get("image")
        or series.get("image")
    )

    row["THUMBNAIL_URL"] = clean_text(
        episode.get("image")
    )

    # --------------------------------------------------------
    # CATEGORIES
    # --------------------------------------------------------

    for i in range(3):

        key = f"CATEGORY {i + 1}"

        if i < len(genres):

            row[key] = clean_text(
                genres[i]
            )

        else:

            row[key] = ""

    # --------------------------------------------------------
    # DATE
    # --------------------------------------------------------

    row["DATE"] = clean_text(
        episode.get("year")
        or series.get("year")
    )

    # --------------------------------------------------------
    # KEYWORDS
    # --------------------------------------------------------

    row["KEYWORDS"] = generate_keywords(
        series,
        episode
    )

    # --------------------------------------------------------
    # EPISODE EXTRA DATA
    # --------------------------------------------------------

    row["DESCRIPTION"] = clean_text(
        episode.get("description")
    )

    row["YEAR"] = clean_text(
        episode.get("year")
        or series.get("year")
    )

    row["DURATION"] = clean_text(
        episode.get("duration")
    )

    row["RATING"] = clean_text(
        episode.get("rating")
    )

    row["GENRES"] = list_to_text(
        episode.get("genres")
        or genres
    )

    row["CAST"] = list_to_text(
        episode.get("cast")
        or cast
    )

    row["NEXT_EPISODE"] = clean_text(
        episode.get("next_episode")
    )

    row["PREV_EPISODE"] = clean_text(
        episode.get("prev_episode")
    )

    row["IFRAMES"] = json_string(
        episode.get("iframes", [])
    )

    row["EPISODE_IMAGE"] = clean_text(
        episode.get("image")
    )

    # --------------------------------------------------------
    # SERIES EXTRA DATA
    # --------------------------------------------------------

    row["SERIES_URL"] = series_url

    row["SERIES_DESCRIPTION"] = clean_text(
        series.get("description")
    )

    row["SERIES_YEAR"] = clean_text(
        series.get("year")
    )

    row["SERIES_GENRES"] = list_to_text(
        genres
    )

    row["SERIES_CAST"] = list_to_text(
        cast
    )

    row["SERIES_IMAGE"] = clean_text(
        series.get("image")
    )

    row["SOURCE_JSON_FILE"] = safe_filename(
        source_file
    )

    # --------------------------------------------------------
    # FULL RAW JSON
    # --------------------------------------------------------

    # This guarantees that the original nested data
    # remains available even if a new field appears later.
    row["RAW_JSON"] = json_string({
        "series": series,
        "episode": episode
    })

    return row


# ============================================================
# PROCESS ALL DATA
# ============================================================

def main():

    print("=" * 70)
    print("          ANIME JSON -> CSV CONVERTER")
    print("=" * 70)

    print()
    print("Source:")
    print(BASE_DIR)

    print()
    print("Searching JSON files...")

    json_files = find_json_files()

    print(
        f"JSON files found: {len(json_files)}"
    )

    if not json_files:

        print()
        print("ERROR: No JSON files found.")
        print()
        print(
            "Check this folder:"
        )
        print(BASE_DIR)

        return

    # --------------------------------------------------------
    # MULTI-THREAD JSON LOADING
    # --------------------------------------------------------

    print()
    print(
        f"Loading JSON files using "
        f"{MAX_WORKERS} threads..."
    )

    results = []

    with ThreadPoolExecutor(
        max_workers=MAX_WORKERS
    ) as executor:

        futures = [
            executor.submit(
                load_json_file,
                filepath
            )
            for filepath in json_files
        ]

        for future in as_completed(futures):

            result = future.result()

            results.append(result)

    # Keep deterministic order
    results.sort(
        key=lambda x: x["file"]
    )

    # --------------------------------------------------------
    # ERROR CHECK
    # --------------------------------------------------------

    errors = [
        x for x in results
        if x["data"] is None
    ]

    if errors:

        print()
        print(
            f"WARNING: {len(errors)} JSON files "
            f"could not be read."
        )

        for item in errors:

            print(
                "ERROR:",
                item["file"]
            )

            print(
                "       ",
                item["error"]
            )

    valid_results = [
        x for x in results
        if isinstance(x["data"], dict)
    ]

    print()
    print(
        f"Valid JSON files: "
        f"{len(valid_results)}"
    )

    # --------------------------------------------------------
    # FIND MAXIMUM LINKS
    # --------------------------------------------------------

    print()
    print(
        "Scanning maximum streaming/download links..."
    )

    max_streams = 0
    max_downloads = 0

    for result in valid_results:

        stats = analyze_file(result)

        max_streams = max(
            max_streams,
            stats["stream_max"]
        )

        max_downloads = max(
            max_downloads,
            stats["download_max"]
        )

    print()
    print(
        f"Maximum streaming links found: "
        f"{max_streams}"
    )

    print(
        f"Maximum download links found: "
        f"{max_downloads}"
    )

    # --------------------------------------------------------
    # HEADERS
    # --------------------------------------------------------

    headers = make_headers(
        max_streams,
        max_downloads
    )

    print()
    print(
        f"Total CSV columns: {len(headers)}"
    )

    # --------------------------------------------------------
    # CREATE ROWS
    # --------------------------------------------------------

    print()
    print("Converting episodes to CSV rows...")

    rows = []

    row_id = 1

    for result in valid_results:

        series = result["data"]

        episodes = get_episode_records(
            series
        )

        for episode in episodes:

            row = make_row(
                series=series,
                episode=episode,
                source_file=result["file"],
                row_id=row_id,
                max_streams=max_streams,
                max_downloads=max_downloads
            )

            rows.append(row)

            row_id += 1

    print(
        f"Total CSV rows: {len(rows)}"
    )

    # --------------------------------------------------------
    # WRITE CSV
    # --------------------------------------------------------

    print()
    print("Writing CSV...")

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8-sig",
        newline=""
    ) as f:

        writer = csv.DictWriter(
            f,
            fieldnames=headers,
            extrasaction="ignore"
        )

        writer.writeheader()

        for row in rows:

            writer.writerow({
                header: row.get(header, "")
                for header in headers
            })

    # --------------------------------------------------------
    # FINISHED
    # --------------------------------------------------------

    file_size = os.path.getsize(
        OUTPUT_FILE
    )

    size_mb = file_size / (
        1024 * 1024
    )

    print()
    print("=" * 70)
    print("                  DONE")
    print("=" * 70)

    print()
    print(
        f"JSON files processed : {len(valid_results)}"
    )

    print(
        f"CSV rows             : {len(rows)}"
    )

    print(
        f"CSV columns          : {len(headers)}"
    )

    print(
        f"Max streaming links  : {max_streams}"
    )

    print(
        f"Max download links   : {max_downloads}"
    )

    print(
        f"CSV size             : {size_mb:.2f} MB"
    )

    print()
    print("CSV saved at:")
    print(OUTPUT_FILE)

    print()
    print(
        "Google Sheets me import karne ke liye "
        "isi CSV ko upload karo."
    )


# ============================================================
# RUN
# ============================================================

if __name__ == "__main__":
    main()
